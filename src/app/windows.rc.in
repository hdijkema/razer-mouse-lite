1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/razer-mouse-lite.ico"

1 VERSIONINFO
FILEVERSION @MOUSE_LITE_VERSION_COMMAS@,0
PRODUCTVERSION @MOUSE_LITE_VERSION_COMMAS@,0
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Razer Mouse Lite\0"
            VALUE "ProductName", "Razer Mouse Lite\0"
            VALUE "FileVersion", "@MOUSE_LITE_VERSION@\0"
            VALUE "ProductVersion", "@MOUSE_LITE_VERSION@\0"
            VALUE "OriginalFilename", "razer-mouse.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

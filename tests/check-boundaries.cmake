foreach(module core device ui app)
    file(GLOB_RECURSE sources "${ROOT}/src/${module}/*.cpp" "${ROOT}/src/${module}/*.h")
    foreach(source IN LISTS sources)
        file(READ "${source}" content)
        string(TOLOWER "${content}" content)
        if(content MATCHES "#[ \t]*include[ \t]*[<\"](windows[.]h|hidsdi[.]h|hidpi[.]h|setupapi[.]h|dbt[.]h|unistd[.]h|fcntl[.]h|libudev[.]h|linux/|sys/)")
            message(FATAL_ERROR "Native OS header in shared module: ${source}. Move it behind platform.h.")
        endif()
    endforeach()
endforeach()
message(STATUS "Shared modules contain no native OS headers.")
